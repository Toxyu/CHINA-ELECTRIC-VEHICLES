# Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side AI; never expose this as NEXT_PUBLIC_*
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional email delivery for verification/reset links (Resend)
RESEND_API_KEY=
EMAIL_FROM=E.V CHINA GLOBAL <onboarding@resend.dev>
APP_URL=http://localhost:3000
COMPANY_LEGAL_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=

# One-time admin bootstrap: supply only when running `npm run admin:bootstrap`
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# One-time staff provisioning: set only when running `npm run staff:create`
STAFF_EMAIL=
STAFF_NAME=
STAFF_ROLE=
STAFF_PASSWORD=
